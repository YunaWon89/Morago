# Example environment variables (no real secrets here)
# Copy the variables below to apps/api/.env
DATABASE_URL="mysql://root:root@localhost:3306/morago"
JWT_SECRET="replace-with-a-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN_DAYS=7
CLIENT_URL="http://localhost:5173"
PORT=3000

# Optional, used only by: pnpm exec tsx prisma/create-admin.ts (run from apps/api)
# ADMIN_PHONE=01000000000
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-please
# ADMIN_NAME=Admin

# Percentage of each call charge kept by the platform (placeholder value, to be confirmed)
PLATFORM_COMMISSION_PERCENT=20
