# Copy this file to .env and fill in the values. Never commit .env.

NODE_ENV=development
PORT=3000

# MySQL started by docker-compose.yml (host port 3307 -> container 3306)
DATABASE_URL=mysql://root:root@127.0.0.1:3307/morago

# Any random string of at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_EXPIRES_IN_DAYS=7

# Address of the web app (used in e-mail links)
# several addresses allowed, comma separated (CORS in production)
CLIENT_URL=http://localhost:5173
# max auth requests per IP per 15 minutes
RATE_LIMIT_AUTH_MAX=30

# Business rules
PLATFORM_COMMISSION_PERCENT=20
TOPUP_BANK_NAME=KEB Hana Bank
TOPUP_ACCOUNT_NUMBER=1234 5678 9101 1234
TOPUP_MIN_AMOUNT=10000
PAYOUT_MIN_AMOUNT=50000

# Uploaded files (avatars, documents)
# A call is ended automatically after this many minutes.
CALL_MAX_MINUTES=120

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Only for creating the first admin (see README). Remove the password afterwards.
ADMIN_PHONE=01000000000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-12345
ADMIN_NAME=Admin
